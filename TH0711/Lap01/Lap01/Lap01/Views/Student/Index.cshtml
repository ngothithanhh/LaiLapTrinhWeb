@model IEnumerable<Lap01.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<a asp-action="Create" class="btn btn-primary">Create Student</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.DateOfBirth</td>
                @{
                    string str = "";
                    switch (item.Branch)
                    {
                        case Branch.IT:
                            str = "CNTT";
                            break;
                        case Branch.BE:
                            str = "Kinh tế";
                            break;
                        case Branch.CE:
                            str = "Công trình";
                            break;
                        case Branch.EE:
                            str = "Điện - Điện tử";
                            break;
                    }
                }
            <td>@str</td>
            <td>@(item.Gender == Gender.Male?"Nam":"Nữ")</td>
            <td>@(item.IsRegular?"Chính quy":"Phi chính quy")</td>
            <td>@item.Address</td>
            <td>@item.Email</td>
            
        </tr>
}
    </tbody>
</table>
