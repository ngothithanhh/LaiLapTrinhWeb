@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/NgoThiThanh_Layout.cshtml";
}
@model List<HangHoa>

<p>
	<a asp-controller="Home" asp-action="Create">Thêm Hàng Hóa mới</a>
</p>

@Html.Partial("NgoThiThanh_MainContent")

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<script>
		$(document).ready(function () {
			$('.loaihang-item').click(function(e){
			e.preventDefault();

			var maloaiId = $(this).data('maloai');
			$.ajax({
				url: '@Url.Action("HangHoaTheoId", "Home")',
				type: 'GET',
				data: { id: maloaiId },
				success: function (data) {
					var html = '';
					$.each(data, function(index,item){
						html += '<div class="grid_1_of_4 images_1_of_4">'+
									'<a href="preview.html"><img src="images/' + item.anh + '" alt="" /></a>'+
									'<h2>' + item.tenHang + '</h2>'+
									'<div class="price-details">'+
										'<div class="price-number">'+
											'<p><span class="rupees">' + item.gia + '</span></p>'+
										'</div>'+
										'<div class="add-cart">'+
											'<h4><a href="preview.html">Add to Cart</a></h4>'+
										'</div>'+
										'<div class="clear"></div>'+
									'</div>'+
								'</div>';
					});

					$('#main-content').html(html);
				}
			});
			});

		});
	</script>

    <script>
        $(document).ready(function () {
            $('#btnTimKiem').click(function () {
                timKiemSanPham();
            });

            $('#txtTimKiem').keypress(function (e) {
                if (e.which == 13) { // phím Enter
                    timKiemSanPham();
                }
            });

            function timKiemSanPham() {
                var keyword = $('#txtTimKiem').val().trim();
                if (keyword === "") {
                    alert("Vui lòng nhập tên sản phẩm!");
                    return;
                }

                $.ajax({
                    url: '/Home/TimKiem',
                    type: 'GET',
                    data: { keyword: keyword },
                    success: function (data) {
                        var html = '';
                        if (data.length === 0) {
                            html = '<p style="text-align:center; color:#999; font-size:20px; padding:50px; grid-column:1/-1;">Không tìm thấy sản phẩm nào!</p>';
                        } else {
                            $.each(data, function (i, item) {
                                html += '<div class="grid_1_of_4 images_1_of_4">' +
                                    '<a href="#"><img src="/images/' + item.anh + '" alt="" style="width:100%; height:200px; object-fit:cover;" /></a>' +
                                    '<h2>' + item.tenHang + '</h2>' +
                                    '<div class="price-details">' +
                                    '<div class="price-number"><p><span class="rupees">' + item.gia.toLocaleString() + ' ₫</span></p></div>' +
                                    '<div class="add-cart"><h4><a href="#">Add to Cart</a></h4></div>' +
                                    '<div class="clear"></div></div></div>';
                            });
                        }
                        $('#main-content').html(html);
                    },
                    error: function () {
                        alert("Có lỗi khi tìm kiếm!");
                    }
                });
            }
        });
    </script>

    <script>
        var currentPage = 1;
        const pageSize = 8;

        $(document).ready(function () {
            loadPage(1); 

            $('#btnNext').click(function () {
                loadPage(currentPage + 1);
            });

            $('#btnPrev').click(function () {
                loadPage(currentPage - 1);
            });
        });

        function loadPage(page) {
            $.ajax({
                url: '/Home/LoadSanPham',
                type: 'GET',
                data: { page: page, pageSize: pageSize },
                success: function (res) {
                    var html = '';
                    $.each(res.data, function (i, item) {
                        html += '<div class="grid_1_of_4 images_1_of_4">' +
                            '<a href="#"><img src="/images/' + item.anh + '" alt="" style="width:100%; height:200px; object-fit:cover;" /></a>' +
                            '<h2>' + item.tenHang + '</h2>' +
                            '<div class="price-details">' +
                            '<div class="price-number"><p><span class="rupees">' + Number(item.gia).toLocaleString() + ' ₫</span></p></div>' +
                            '<div class="add-cart"><h4><a href="#">Add to Cart</a></h4></div>' +
                            '<div class="clear"></div></div></div>';
                    });

                    $('#main-content').html(html);
                    currentPage = res.currentPage;

                    $('#pageInfo').text('Trang ' + currentPage + ' / ' + res.totalPages);
                    $('#btnPrev').prop('disabled', !res.hasPrev);
                    $('#btnNext').prop('disabled', !res.hasNext);
                    $('#pagination').show();
                }
            });
        }
    </script>
}
	