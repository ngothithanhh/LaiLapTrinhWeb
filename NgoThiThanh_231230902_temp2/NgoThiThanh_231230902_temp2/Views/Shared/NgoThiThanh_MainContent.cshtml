@model IEnumerable<NgoThiThanh_231230902_temp2.Models.HangHoa>
<div class="main">
	<div class="content">
		<!-- Begin New Product -->
		<div class="content_top">
			<div class="heading">
				<h3>Ngô Thị Thanh</h3>
			</div>
			<div class="see">
				<p><a href="#">See all Products</a></p>
			</div>
			<div class="clear"></div>
		</div>
		<div class="section group" id="main-content">
			@foreach(var item in Model)
			{
				<div class="grid_1_of_4 images_1_of_4">
					<a href="preview.html"><img src="images/@item.Anh" alt="" /></a>
					<h2>@item.TenHang</h2>
					<div class="price-details">
						<div class="price-number">
							<p><span class="rupees">@item.Gia</span></p>
						</div>
						<div class="add-cart">
							<h4><a href="preview.html">Add to Cart</a></h4>
							<h4><a asp-controller="HangHoas" asp-action="Edit" asp-route-id="@item.MaHang">Edit</a></h4> 
							<h4><a asp-controller="HangHoas" asp-action="Details" asp-route-id="@item.MaHang">Details</a> </h4>
							<h4><a asp-controller="HangHoas" asp-action="Delete" asp-route-id="@item.MaHang">Delete</a></h4>
						</div>
						<div class="clear"></div>
					</div>
				</div>
			}
		</div>

		<div id="pagination" style="text-align:center; margin:40px 0; display:none;">
			<button id="btnPrev" class="btn-page" disabled>« Trước</button>
			<span id="pageInfo" style="margin:0 20px; font-size:18px; font-weight:bold;"></span>
			<button id="btnNext" class="btn-page">Sau »</button>
		</div>
		<!-- End New Product -->
		<!-- Begin Feature Products -->
	
		<!-- End Feature Products -->
	</div>
</div>
